# gentoo-forge hardware profile — brox (JUBILEUM) port
# Same format as gentoo-forge/config/hardware.env.example.
# Copy to config/hardware.env inside a gentoo-forge checkout; NEVER commit
# local disk selections (the forge's own rule — the disk value below is a
# placeholder for the live environment, where the internal UFS usually
# enumerates as the first SCSI disk; VERIFY with lsblk before any use).
TARGET_DISK=""
HOSTNAME="violator"
TIMEZONE="America/New_York"
LOCALE="en_US.UTF-8"
# i3-1315U is Raptor Lake; GCC's -march name for the family is alderlake.
CPU_MARCH="alderlake"
# 8 GiB RAM: cap parallelism harder than the desktop profile (-j6 -l6).
MAKEOPTS="-j6 -l8"
USERNAME="branden"
EFI_GIB="1"
# Desktop profile carries 20 GiB swap for hibernation. This machine has
# 8 GiB RAM and a 128 GiB disk, and sleep under coreboot is the shakiest
# part of the platform — swap is sized for memory pressure, not for a
# hibernation promise nobody can keep here.
SWAP_GIB="8"
GPU_DRIVER="intel"
DESKTOP="plasma"
INIT_SYSTEM="openrc"
# Forge default is btrfs + Snapper. Kept here for consistency with the
# forge; note the violator installer (gentoo_install.sh) currently
# formats ext4 — reconcile before use if snapshots matter on this box.
FILESYSTEM="btrfs"
