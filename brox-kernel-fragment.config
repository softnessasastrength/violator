# brox (JUBILEUM) kernel config fragment — the options the Chrultrabook
# audio setup checks for the ADL/RPL SOF platform, plus the platform
# basics a hand-rolled config tends to miss. Merge into .config, then
# run: make olddefconfig
#
# AUTHOR: Ember (Muse) · EVIDENCE: chromebook-linux-audio setup script
# (ADL platform checks), researched 2026-11-22.

# --- SOF audio platform (Alder Lake / Raptor Lake) ---
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_ALDERLAKE=m
CONFIG_SND_SOC_SOF_INTEL_HIFI_EP_IPC=m

# --- Machine drivers the audio script looks for ---
CONFIG_SND_SOC_INTEL_SOF_RT5682_MACH=m
CONFIG_SND_SOC_INTEL_SOF_CS42L42_MACH=m
CONFIG_SND_SOC_INTEL_SOF_DA7219_MACH=m
CONFIG_SND_SOC_INTEL_SOF_NAU8825_MACH=m
CONFIG_SND_SOC_INTEL_SSP_AMP_MACH=m

# --- Codecs / amps commonly paired on this platform ---
CONFIG_SND_SOC_RT5682=m
CONFIG_SND_SOC_RT5682_I2C=m
CONFIG_SND_SOC_CS42L42=m
CONFIG_SND_SOC_DA7219=m
CONFIG_SND_SOC_NAU8825=m
CONFIG_SND_SOC_MAX98357A=m
CONFIG_SND_SOC_MAX98373=m

# --- Storage: the internal drive is UFS (SCSI subsystem) ---
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PCI=y
CONFIG_BLK_DEV_SD=y

# --- Platform basics ---
CONFIG_X86_INTEL_LPSS=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_SPI_PXA2XX=m
CONFIG_PINCTRL_ALDERLAKE=m
CONFIG_INTEL_MEI=m
CONFIG_INTEL_MEI_ME=m
CONFIG_INTEL_MEI_HDCP=m
CONFIG_IWLMVM=m
CONFIG_IWLWIFI=m
